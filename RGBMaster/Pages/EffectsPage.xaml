<Page x:Class="RGBMaster.Pages.EffectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:state="using:AppExecutionManager.State"
      xmlns:common="using:Common">
    <Grid>
        <StackPanel Margin="12">
            <TextBlock Text="Effects" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>
            
            <TextBlock Text="Select an effect to synchronize your devices:" Margin="0,0,0,12"/>
            
            <ListView ItemsSource="{x:Bind Effects}" SelectionMode="Single" SelectionChanged="ListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="common:EffectMetadata">
                        <StackPanel Orientation="Horizontal" Padding="8">
                            <TextBlock Text="{x:Bind EffectName}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ShortDescription}" Margin="12,0,0,0" Opacity="0.7" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="StartEffectButton" Content="Start Effect" Click="StartEffectButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="StopEffectButton" Content="Stop Effect" Click="StopEffectButton_Click"/>
            </StackPanel>
            
            <TextBlock x:Name="StatusTextBlock" Margin="0,16,0,0" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>